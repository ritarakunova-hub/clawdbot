# Локально: скопируйте в .env. На сервере добавляйте значения только в раздел секретов.

# Google Sheets — таблица лидов «Заявки»
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Telegram — внутренние уведомления о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Netlify Forms outgoing webhook: JWS secret для заголовка X-Webhook-Signature
# Создайте случайное значение: openssl rand -hex 32
# Тот же secret задаётся при создании outgoing webhook в Netlify.
NETLIFY_JWS_SECRET=

# Порт приложения
PORT=3000
