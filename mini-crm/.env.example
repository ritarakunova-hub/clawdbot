# Локально: скопируйте этот файл в .env и заполните значениями.
# На Amvera: те же имена задаются в личном кабинете → «Переменные и секреты»,
# в .env файл на проде не нужен и коммитить его нельзя.

# ID таблицы Google Sheets (кусок из URL таблицы между /d/ и /edit)
GOOGLE_SHEET_ID=

# Ключ сервисного аккаунта Google, весь JSON-файл, закодированный в base64
# (как получить — см. README.md, шаг 1)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Порт, на котором слушает сервер (Amvera подставит свой — не обязателен локально)
PORT=3000

# Необязательно: секрет в URL вебхука, чтобы левые запросы не писали в таблицу
WEBHOOK_SECRET=

# Токен Telegram-бота (получить у @BotFather командой /newbot)
TELEGRAM_BOT_TOKEN=

# ID чата/группы, куда слать уведомления о новых заявках
# (как узнать — см. README.md, раздел «Этап 2»)
TELEGRAM_CHAT_ID=
