# Локально: скопируйте в .env и заполните. На Amvera те же имена
# задаются в личном кабинете → «Переменные и секреты» (как секреты).

# --- Claude (генерация текста постов) ---
ANTHROPIC_API_KEY=

# --- Google Sheets (история постов и их статус) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- Telegram: бот и ДВА разных получателя ---
TELEGRAM_BOT_TOKEN=
# Личный чат/группа, куда приходят карточки-черновики с кнопками
# (можно использовать тот же TELEGRAM_CHAT_ID, что в mini-crm/sales-engine)
TELEGRAM_CHAT_ID=
# Публичный канал TAINA, куда бот публикует пост после вашего "Одобрить".
# Бота нужно добавить в канал как администратора (с правом публикации).
# Формат: @username_канала или числовой id (для приватных каналов).
TELEGRAM_CHANNEL_ID=
# Секрет для проверки, что вебхук реально прислал Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- VK (необязательно — если не заполнено, публикация в VK просто пропускается) ---
# Токен сообщества с правом "wall" — Управление сообществом → Работа с API → Создать ключ
VK_ACCESS_TOKEN=
# ID сообщества (число, без минуса) — из ссылки на группу или её настроек
VK_GROUP_ID=

# --- Защита веб-формы паролем (Basic Auth) ---
APP_USERNAME=
APP_PASSWORD=

# --- Прочее ---
PORT=3000
