# Локально: скопируйте в .env и заполните. На Amvera те же имена
# задаются в личном кабинете → «Переменные и секреты» (как секреты).

# --- Telegram (тот же бот и чат, что в мини-CRM / Sales Engine) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Расписание ---
# Часовой пояс для расчёта "сегодня" и для cron
TIMEZONE=Europe/Moscow
# Во сколько проверять и слать напоминание (по умолчанию — 9:00)
CRON_SCHEDULE=0 9 * * *

# --- Ручной запуск /remind/now (необязательно) ---
# Если задать — ручной запуск потребует ?token=ВАШ_СЕКРЕТ в URL
REMINDER_SECRET=

# --- Прочее ---
PORT=3000
