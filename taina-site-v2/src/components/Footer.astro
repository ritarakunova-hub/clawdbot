---
import { contact } from '@/content/copy';
import PrivacyPolicyDoc from './PrivacyPolicyDoc.astro';
import OfertaDoc from './OfertaDoc.astro';
---

<footer class="footer">
  <div class="mark">Taina Studio<span class="dot">.</span></div>
  <p class="tagline">AI и автоматизация для сильного бизнеса.</p>
  <p class="contacts">
    <a href="https://t.me/RitaRakunova">Telegram @RitaRakunova</a>
    <span aria-hidden="true"> · </span>
    <a href="mailto:ritarakunova@gmail.com">ritarakunova@gmail.com</a>
  </p>
  <button type="button" class="motion-toggle" id="motion-toggle" aria-pressed="false">
    Остановить анимацию
  </button>

  <div class="legal">
    <p class="legal-links">
      <a href="#legal-privacy">{contact.legal.privacyTitle}</a>
      <span aria-hidden="true"> · </span>
      <a href="#legal-offer">{contact.legal.offerTitle}</a>
      <span aria-hidden="true"> · </span>
      <span class="legal-status">черновик для юридической проверки</span>
    </p>
    <details class="legal-doc" id="legal-privacy">
      <summary>{contact.legal.privacyTitle}</summary>
      <div class="legal-doc-body">
        <PrivacyPolicyDoc />
      </div>
    </details>
    <details class="legal-doc" id="legal-offer">
      <summary>{contact.legal.offerTitle}</summary>
      <div class="legal-doc-body">
        <OfertaDoc />
      </div>
    </details>
  </div>
</footer>

<script>
  import { isAnimationStoppedByUser, toggleAnimationStopped } from '@/lib/a11y';

  const button = document.getElementById('motion-toggle');
  if (button) {
    const render = () => {
      const stopped = isAnimationStoppedByUser();
      button.textContent = stopped ? 'Возобновить анимацию' : 'Остановить анимацию';
      button.setAttribute('aria-pressed', String(stopped));
    };
    render();
    button.addEventListener('click', () => {
      toggleAnimationStopped();
      render();
    });
  }

  // Ссылки на политику/оферту (здесь и в чекбоксе согласия, Contact.astro)
  // ведут на #legal-privacy/#legal-offer — id стоит прямо на <details>.
  // Автораскрытие <details> по фрагменту браузер гарантирует только для
  // элементов ВНУТРИ закрытого <details>, не для него самого — поэтому
  // раскрываем явно, чтобы клик по ссылке точно показывал текст, а не
  // сворачивал документ.
  function openLegalDocFromHash() {
    const id = location.hash.slice(1);
    if (id !== 'legal-privacy' && id !== 'legal-offer') return;
    const details = document.getElementById(id);
    if (details instanceof HTMLDetailsElement) details.open = true;
  }
  openLegalDocFromHash();
  addEventListener('hashchange', openLegalDocFromHash);
</script>

<style>
  .footer {
    /* html/body/main прозрачные — подвал не 3D-сцена, перекрывает
       холст сам (см. комментарий в Section.astro). */
    background: var(--color-bg);
    padding-block: var(--space-7) var(--space-8);
    padding-inline: clamp(20px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .mark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .dot {
    color: var(--color-gold);
  }

  .tagline,
  .contacts {
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  .contacts a {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
  }

  .contacts a:hover {
    color: var(--color-ivory);
  }

  .motion-toggle {
    align-self: flex-start;
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    /* ≥44px — минимальная зона нажатия (CLAUDE.md, Этап 13). */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-sand);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--duration-response) var(--ease-out),
      border-color var(--duration-response) var(--ease-out);
  }

  .motion-toggle:hover {
    color: var(--color-ivory);
    border-color: var(--color-gold);
  }

  .legal {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .legal-links {
    font-size: var(--text-xs);
  }

  .legal-links a {
    color: var(--color-sand);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    scroll-margin-top: var(--header-height);
  }

  .legal-links a:hover {
    color: var(--color-ivory);
  }

  .legal-status {
    font-style: italic;
  }

  .legal-doc {
    margin-top: var(--space-3);
    scroll-margin-top: var(--header-height);
  }

  .legal-doc summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold);
    /* ≥44px — минимальная зона нажатия (CLAUDE.md, Этап 13), как у
       .faq-item summary в Packages.astro. */
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .legal-doc summary::marker {
    color: var(--color-gold);
  }

  .legal-doc-body {
    margin-top: var(--space-3);
    padding: var(--space-5);
    max-width: var(--measure);
    border: 1px solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  .legal-doc-body :global(h4) {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-ivory);
    margin-bottom: var(--space-3);
  }

  .legal-doc-body :global(h5) {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-gold);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .legal-doc-body :global(p),
  .legal-doc-body :global(li) {
    margin-top: var(--space-2);
  }

  .legal-doc-body :global(ul),
  .legal-doc-body :global(ol) {
    padding-left: var(--space-5);
  }

  .legal-doc-body :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 40%, transparent);
  }

  .legal-doc-body :global(table) {
    margin-top: var(--space-4);
    width: 100%;
    border-collapse: collapse;
  }

  .legal-doc-body :global(th),
  .legal-doc-body :global(td) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    font-size: var(--text-xs);
    border: 1px solid var(--color-line);
  }

  .legal-doc-body :global(th) {
    color: var(--color-ivory);
    font-weight: 600;
  }

  /* Черновик, ещё не прошёл юрпроверку — предупреждение того же вида,
     что «Демо»/«Проявка» (ромб-акцент рубином по краю), но текст в
     sand/ivory: Ruby/Crimson как текст ниже AA (CLAUDE.md, «Бренд»). */
  .legal-doc-body :global(.legal-draft-notice) {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-ruby);
    color: var(--color-sand);
    font-style: italic;
  }

  .legal-doc-body :global(.legal-doc-date) {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-xs);
    color: var(--color-sand);
    font-style: italic;
  }
</style>
