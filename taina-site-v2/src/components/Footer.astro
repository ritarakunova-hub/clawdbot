---
---

<footer class="footer">
  <div class="mark">Taina<span class="dot">.</span></div>
  <p class="tagline">AI и автоматизация для сильного бизнеса.</p>
  <p class="contacts">
    <a href="https://t.me/RitaRakunova">Telegram @RitaRakunova</a>
    <span aria-hidden="true"> · </span>
    <a href="mailto:ritarakunova@gmail.com">ritarakunova@gmail.com</a>
  </p>
  <button type="button" class="motion-toggle" id="motion-toggle" aria-pressed="false">
    Остановить анимацию
  </button>
</footer>

<script>
  import { isAnimationStoppedByUser, toggleAnimationStopped } from '@/lib/a11y';

  const button = document.getElementById('motion-toggle');
  if (button) {
    const render = () => {
      const stopped = isAnimationStoppedByUser();
      button.textContent = stopped ? 'Возобновить анимацию' : 'Остановить анимацию';
      button.setAttribute('aria-pressed', String(stopped));
    };
    render();
    button.addEventListener('click', () => {
      toggleAnimationStopped();
      render();
    });
  }
</script>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-8);
    padding-inline: clamp(20px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .mark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .dot {
    color: var(--color-gold);
  }

  .tagline,
  .contacts {
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  .contacts a {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
  }

  .contacts a:hover {
    color: var(--color-ivory);
  }

  .motion-toggle {
    align-self: flex-start;
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-sand);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--duration-response) var(--ease-out),
      border-color var(--duration-response) var(--ease-out);
  }

  .motion-toggle:hover {
    color: var(--color-ivory);
    border-color: var(--color-gold);
  }
</style>
