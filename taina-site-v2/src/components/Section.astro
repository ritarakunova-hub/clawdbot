---
interface Props {
  id: string;
  label: string;
  class?: string;
}

const { id, label, class: className } = Astro.props;
---

<section id={id} aria-label={label} class:list={['section', className]}>
  <slot />
</section>

<style>
  .section {
    /* html/body/main прозрачные (см. base.css) — за ними общий холст
       3D-сцен. Обычные (не-3D) секции должны сами перекрывать холст
       непрозрачным фоном, иначе он будет просвечивать. */
    background: var(--color-bg);
    padding-block: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--color-line);
    scroll-margin-top: var(--header-height);
  }

  .section:first-of-type {
    border-top: none;
  }
</style>
