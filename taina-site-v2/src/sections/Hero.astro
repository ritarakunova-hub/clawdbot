---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { hero } from '@/content/copy';
---

<Section id="hero" label="Первый экран">
  <Container>
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p class="lead measure">{hero.lead}</p>
    <div class="actions">
      <Button href="#contact">{hero.primaryCta}</Button>
      <Button href="#proyavka" variant="text">{hero.secondaryCta}</Button>
    </div>
    <ul class="facts" aria-label="Коротко">
      {hero.facts.map((fact) => <li>{fact}</li>)}
    </ul>
    <p class="brand-line">{hero.brandLine}</p>
  </Container>
</Section>

<style>
  .eyebrow {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-sand);
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--text-3xl);
    max-width: 16ch;
  }

  .lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-sand);
  }

  .actions {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .facts {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  .facts li {
    padding-right: var(--space-5);
    margin-right: var(--space-5);
    border-right: 1px solid var(--color-line);
  }

  .facts li:last-child {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .brand-line {
    margin-top: var(--space-7);
    font-size: var(--text-xs);
    color: var(--color-sand);
  }
</style>
