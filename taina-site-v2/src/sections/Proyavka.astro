---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import { proyavka } from '@/content/copy';
---

<Section id="proyavka" label={proyavka.title}>
  <Container>
    <h2>{proyavka.title}</h2>
    <div class="text">
      {proyavka.paragraphs.map((paragraph) => <p class="measure">{paragraph}</p>)}
    </div>
  </Container>
</Section>

<style>
  h2 {
    font-size: var(--text-2xl);
  }

  .text {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-sand);
  }
</style>
