---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import { demo } from '@/content/copy';

const { people, questions, minutes, rate } = demo.roi.fields;
---

<Section id="demo" label={demo.title}>
  <Container>
    <p class="eyebrow" data-reveal>{demo.eyebrow}</p>
    <h2 data-reveal>{demo.heading}</h2>
    <p class="rag-note measure" data-reveal>{demo.ragNote}</p>

    <ol class="steps">
      {
        demo.steps.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="step-tag" aria-hidden="true">
              {step.tag}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="privacy measure">{demo.privacyLine}</p>

    <div class="block" data-reveal>
      <h3 class="block-title">Попробуйте сами</h3>
      <p class="lede measure">
        Работает прямо здесь, на демо-базе TAINA — без сети и без ваших данных. Задайте свой
        вопрос или возьмите готовый.
      </p>

      <div class="chat" id="demo-chat">
        <form class="chat-form" id="demo-chat-form">
          <label class="chat-label" for="demo-chat-input">Ваш вопрос</label>
          <div class="chat-row">
            <input
              type="text"
              id="demo-chat-input"
              name="question"
              autocomplete="off"
              placeholder="Например: сколько стоит внедрение?"
            />
            <button class="chat-submit" type="submit">Спросить</button>
          </div>
          <div class="chat-chips" role="group" aria-label="Примеры вопросов">
            {
              demo.scenarios.map((scenario) => (
                <button class="chip" type="button" data-question={scenario.question}>
                  {scenario.question}
                </button>
              ))
            }
          </div>
        </form>

        <div class="chat-stage" aria-hidden="true">
          <svg class="chat-diamond" id="demo-chat-diamond" viewBox="0 0 40 60">
            <polygon points="20,0 38,30 2,30" fill="var(--color-ruby)" />
            <polygon points="38,30 20,60 2,30" fill="var(--color-crimson)" />
          </svg>
          <span class="chat-beam" id="demo-chat-beam" />
          <svg class="chat-cat" id="demo-chat-cat" viewBox="0 0 60 24">
            <ellipse class="eye" cx="18" cy="12" rx="7" ry="9" fill="var(--color-sand)" />
            <ellipse class="eye" cx="42" cy="12" rx="7" ry="9" fill="var(--color-sand)" />
          </svg>
        </div>

        <div class="chat-answer" id="demo-chat-answer" aria-live="polite">
          <p class="chat-placeholder" id="demo-chat-placeholder">Здесь появится ответ.</p>
        </div>
      </div>
    </div>

    <div class="block" data-reveal>
      <p class="eyebrow">{demo.roi.eyebrow}</p>
      <h3>{demo.roi.title}</h3>
      <p class="lede measure">{demo.roi.lede}</p>

      <div class="roi">
        <div class="roi-inputs">
          <div class="roi-field">
            <label for="roi-people">
              {people.label} <span class="val" id="roi-people-val">{people.value}</span>
            </label>
            <input
              type="range"
              id="roi-people"
              min={people.min}
              max={people.max}
              step={people.step}
              value={people.value}
            />
          </div>
          <div class="roi-field">
            <label for="roi-questions">
              {questions.label} <span class="val" id="roi-questions-val">{questions.value}</span>
            </label>
            <input
              type="range"
              id="roi-questions"
              min={questions.min}
              max={questions.max}
              step={questions.step}
              value={questions.value}
            />
          </div>
          <div class="roi-field">
            <label for="roi-minutes">
              {minutes.label} <span class="val" id="roi-minutes-val">{minutes.value}</span>
            </label>
            <input
              type="range"
              id="roi-minutes"
              min={minutes.min}
              max={minutes.max}
              step={minutes.step}
              value={minutes.value}
            />
          </div>
          <div class="roi-field">
            <label for="roi-rate">
              {rate.label} <span class="val" id="roi-rate-val">{rate.value}</span>
            </label>
            <input
              type="range"
              id="roi-rate"
              min={rate.min}
              max={rate.max}
              step={rate.step}
              value={rate.value}
            />
          </div>
        </div>

        <div class="roi-outputs" aria-live="polite">
          <div class="roi-out">
            <p class="k">Часов в месяц уходит на это сейчас</p>
            <p class="v" id="roi-out-hours">0 <span>ч/мес</span></p>
          </div>
          <div class="roi-out">
            <p class="k">Во сколько это обходится компании</p>
            <p class="v" id="roi-out-money">0 <span>₽/мес</span></p>
          </div>
          <button class="copy-btn" id="roi-copy" type="button">{demo.roi.copyButton}</button>
          <p class="copy-msg" id="roi-copy-msg" role="status"></p>
        </div>
      </div>

      <p class="note measure">{demo.roi.note}</p>
    </div>
  </Container>
</Section>

<script define:vars={{ scenarios: demo.scenarios }}>
  // --- Демо-чат: контракт POST /api/ask {question} → {answer, sources[], found}.
  // Пока нет адреса вебхука n8n — функции /api/ask не существует, запрос
  // падает мгновенно (или по таймауту), и чат сам переключается в
  // mock-режим на записанных ответах ниже. Когда бэкенд появится —
  // достаточно будет добавить Netlify Function по этому пути, менять
  // фронтенд не придётся.
  const REQUEST_TIMEOUT_MS = 12_000;
  const COOLDOWN_MS = 1_500;
  const refusalScenario = scenarios.find((s) => s.isRefusal) ?? scenarios[scenarios.length - 1];
  const answerScenarios = scenarios.filter((s) => s !== refusalScenario);

  function normalize(text) {
    return text
      .toLowerCase()
      .replace(/[^\p{L}\p{N}\s]/gu, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function matchScore(input, question) {
    const normInput = normalize(input);
    const normQuestion = normalize(question);
    if (!normInput || !normQuestion) return 0;
    if (normInput === normQuestion) return 100;
    if (normInput.includes(normQuestion) || normQuestion.includes(normInput)) return 50;
    const inputWords = new Set(normInput.split(' ').filter((w) => w.length > 3));
    const questionWords = normQuestion.split(' ').filter((w) => w.length > 3);
    return questionWords.filter((w) => inputWords.has(w)).length;
  }

  function mockAsk(question) {
    let best = null;
    let bestScore = 0;
    for (const scenario of answerScenarios) {
      const score = matchScore(question, scenario.question);
      if (score > bestScore) {
        bestScore = score;
        best = scenario;
      }
    }
    if (best) {
      return { answer: best.answer, sources: [best.tag], found: true };
    }
    return { answer: refusalScenario.answer, sources: [], found: false };
  }

  async function askBackend(question, signal) {
    const res = await fetch('/api/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question }),
      signal,
    });
    if (!res.ok) throw new Error(`статус ${res.status}`);
    const data = await res.json();
    if (typeof data.answer !== 'string' || typeof data.found !== 'boolean') {
      throw new Error('неожиданный формат ответа');
    }
    return data;
  }

  async function askWithRetry(question) {
    for (let attempt = 0; attempt < 2; attempt++) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
      try {
        const data = await askBackend(question, controller.signal);
        clearTimeout(timer);
        return data;
      } catch {
        clearTimeout(timer);
      }
    }
    return null;
  }

  const form = document.getElementById('demo-chat-form');
  const input = document.getElementById('demo-chat-input');
  const submitBtn = form?.querySelector('.chat-submit');
  const chips = document.querySelectorAll('#demo-chat-form .chip');
  const diamond = document.getElementById('demo-chat-diamond');
  const beam = document.getElementById('demo-chat-beam');
  const cat = document.getElementById('demo-chat-cat');
  const answerBox = document.getElementById('demo-chat-answer');

  let busy = false;

  function renderAnswer({ answer, sources, found }) {
    answerBox.innerHTML = '';
    const p = document.createElement('p');
    p.className = found ? 'a' : 'a a--refusal';
    p.textContent = answer;
    answerBox.appendChild(p);
    if (found && sources?.length) {
      const tag = document.createElement('p');
      tag.className = 'tag';
      tag.textContent = sources[0];
      answerBox.insertBefore(tag, p);
    }
  }

  function setBusy(state) {
    busy = state;
    if (submitBtn) submitBtn.disabled = state;
    chips.forEach((c) => (c.disabled = state));
  }

  async function ask(question) {
    if (busy || !question.trim()) return;
    setBusy(true);

    diamond.classList.add('is-thinking');
    answerBox.innerHTML = '<p class="chat-status">Ищу в базе знаний…</p>';

    const remote = await askWithRetry(question);
    const result = remote ?? mockAsk(question);

    diamond.classList.remove('is-thinking');
    beam.classList.remove('is-returning');
    // Перезапуск CSS-анимации на повторном вопросе.
    void beam.offsetWidth;
    beam.classList.add('is-active');

    await new Promise((resolve) => setTimeout(resolve, 700));

    if (result.found) {
      renderAnswer(result);
    } else {
      beam.classList.remove('is-active');
      beam.classList.add('is-returning');
      await new Promise((resolve) => setTimeout(resolve, 500));
      cat.classList.add('is-blinking');
      setTimeout(() => cat.classList.remove('is-blinking'), 280);
      renderAnswer(result);
    }

    // Небольшая пауза перед следующим вопросом — простая защита от
    // случайного спама кликами по чипам (полноценный лимит на сервере
    // появится вместе с Netlify Function-прокси к n8n).
    setTimeout(() => setBusy(false), COOLDOWN_MS);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (busy) {
      answerBox.innerHTML = '<p class="chat-status">Уже ищу ответ — секунду…</p>';
      return;
    }
    ask(input.value);
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const question = chip.dataset.question ?? '';
      input.value = question;
      input.focus();
      ask(question);
    });
  });

  const peopleEl = document.getElementById('roi-people');
  const questionsEl = document.getElementById('roi-questions');
  const minutesEl = document.getElementById('roi-minutes');
  const rateEl = document.getElementById('roi-rate');

  function fmt(n) {
    return Math.round(n).toLocaleString('ru-RU');
  }

  function calc() {
    const people = parseFloat(peopleEl.value);
    const questions = parseFloat(questionsEl.value);
    const minutes = parseFloat(minutesEl.value);
    const rate = parseFloat(rateEl.value);

    document.getElementById('roi-people-val').textContent = String(people);
    document.getElementById('roi-questions-val').textContent = String(questions);
    document.getElementById('roi-minutes-val').textContent = String(minutes);
    document.getElementById('roi-rate-val').textContent = fmt(rate);

    // Формула дословно из docs/old-site-calculator.md: 21 — рабочих дней в месяце.
    const hoursPerMonth = (people * questions * minutes * 21) / 60;
    const moneyPerMonth = hoursPerMonth * rate;

    document.getElementById('roi-out-hours').innerHTML = fmt(hoursPerMonth) + ' <span>ч/мес</span>';
    document.getElementById('roi-out-money').innerHTML = fmt(moneyPerMonth) + ' <span>₽/мес</span>';

    return { people, questions, minutes, rate, hoursPerMonth, moneyPerMonth };
  }

  [peopleEl, questionsEl, minutesEl, rateEl].forEach((el) => el.addEventListener('input', calc));
  calc();

  const copyBtn = document.getElementById('roi-copy');
  const copyMsg = document.getElementById('roi-copy-msg');
  copyBtn.addEventListener('click', () => {
    const { people, questions, minutes, rate, hoursPerMonth, moneyPerMonth } = calc();
    const text =
      `Расчёт стоимости поиска информации (TAINA Studio)\n\n` +
      `Вводные: ${people} сотрудников, ${questions} вопросов/день на человека, ${minutes} мин на ответ, ${fmt(rate)} ₽/час\n\n` +
      `Сейчас уходит: ${fmt(hoursPerMonth)} часов в месяц (≈ ${fmt(moneyPerMonth)} ₽/месяц)\n\n` +
      `AI-пилот — 70 000 ₽, AI-разбор (если нужен предварительный анализ) — 15 000 ₽\n` +
      `taina.studio`;
    navigator.clipboard
      .writeText(text)
      .then(() => {
        copyMsg.textContent = copiedMessage;
        setTimeout(() => {
          copyMsg.textContent = '';
        }, 4000);
      })
      .catch(() => {
        copyMsg.textContent = copyFailMessage;
      });
  });
</script>

<style>
  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--text-2xl);
    max-width: 22ch;
  }

  h3 {
    font-size: var(--text-xl);
    max-width: 24ch;
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--color-sand);
    font-size: var(--text-lg);
  }

  .rag-note {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 5%, transparent);
    color: var(--color-sand);
    font-style: italic;
  }

  .steps {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .step {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-4);
  }

  @media (max-width: 560px) {
    .step {
      grid-template-columns: 1fr;
    }
  }

  .step-tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-gold);
    padding-top: 3px;
  }

  .step h3 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    max-width: none;
  }

  .step p {
    margin-top: var(--space-1);
    color: var(--color-sand);
    max-width: var(--measure);
  }

  .privacy {
    margin-top: var(--space-7);
    font-size: var(--text-sm);
    color: var(--color-sand);
  }

  .block {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .block-title {
    font-size: var(--text-xl);
  }

  .chat {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .chat-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-sand);
    margin-bottom: var(--space-2);
  }

  .chat-row {
    display: flex;
    gap: var(--space-3);
  }

  @media (max-width: 560px) {
    .chat-row {
      flex-direction: column;
    }
  }

  .chat-row input[type='text'] {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-size: var(--text-base);
    color: var(--color-ivory);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    transition: border-color var(--duration-response) var(--ease-out);
  }

  .chat-row input[type='text']:focus-visible {
    outline: none;
    border-color: var(--color-gold);
  }

  .chat-submit {
    padding: 0 var(--space-6);
    font: inherit;
    font-weight: 600;
    color: var(--color-bg);
    background: var(--color-gold);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: opacity var(--duration-response) var(--ease-out);
  }

  .chat-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .chat-chips {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-sand);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition:
      color var(--duration-response) var(--ease-out),
      border-color var(--duration-response) var(--ease-out);
  }

  .chip:hover,
  .chip:focus-visible {
    color: var(--color-ivory);
    border-color: var(--color-gold);
  }

  .chip:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .chat-stage {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 40px;
  }

  .chat-diamond {
    width: 26px;
    height: 40px;
    flex: none;
    transition: transform var(--duration-response) var(--ease-out);
  }

  .chat-diamond.is-thinking {
    animation: chat-diamond-pulse 900ms var(--ease-in-out) infinite;
  }

  @keyframes chat-diamond-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.12);
    }
  }

  .chat-beam {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--color-ruby), var(--color-gold));
    transform-origin: left;
    transform: scaleX(0);
    opacity: 0;
  }

  .chat-beam.is-active {
    animation: chat-beam-grow 700ms var(--ease-in-out) forwards;
  }

  .chat-beam.is-returning {
    animation: chat-beam-shrink 500ms var(--ease-out) forwards;
  }

  @keyframes chat-beam-grow {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @keyframes chat-beam-shrink {
    0% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  .chat-cat {
    width: 44px;
    height: 18px;
    flex: none;
    opacity: 0.85;
  }

  .chat-cat .eye {
    transform-origin: center;
    transition: transform 140ms var(--ease-out);
  }

  .chat-cat.is-blinking .eye {
    animation: chat-cat-blink 280ms var(--ease-in-out);
  }

  @keyframes chat-cat-blink {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.08);
    }
  }

  .chat-answer {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    min-height: 3.5em;
  }

  .chat-answer .chat-placeholder,
  .chat-answer .chat-status {
    color: var(--color-sand);
    font-style: italic;
  }

  .chat-answer .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold);
    margin-bottom: var(--space-2);
    animation: chat-answer-in 300ms var(--ease-out);
  }

  .chat-answer .a {
    color: var(--color-ivory);
    max-width: var(--measure);
    animation: chat-answer-in 300ms var(--ease-out);
  }

  .chat-answer .a--refusal {
    color: var(--color-sand);
  }

  @keyframes chat-answer-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .roi {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-line);
  }

  @media (max-width: 820px) {
    .roi {
      grid-template-columns: 1fr;
    }
  }

  .roi-inputs {
    padding: var(--space-6);
    border-right: 1px solid var(--color-line);
  }

  @media (max-width: 820px) {
    .roi-inputs {
      border-right: none;
      border-bottom: 1px solid var(--color-line);
    }
  }

  .roi-field {
    margin-bottom: var(--space-5);
  }

  .roi-field:last-child {
    margin-bottom: 0;
  }

  .roi-field label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-sand);
    margin-bottom: var(--space-3);
  }

  .roi-field .val {
    color: var(--color-gold);
    font-weight: 600;
  }

  .roi-field input[type='range'] {
    width: 100%;
    accent-color: var(--color-gold);
  }

  .roi-outputs {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
  }

  .roi-out .k {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-sand);
    margin-bottom: var(--space-2);
  }

  .roi-out .v {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-2xl);
    color: var(--color-gold);
  }

  .roi-out .v span {
    font-size: var(--text-sm);
    color: var(--color-sand);
    font-family: var(--font-sans);
  }

  .copy-btn {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-sand);
    background: transparent;
