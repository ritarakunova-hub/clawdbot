---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import { project } from '@/content/copy';
---

<Section id="project" label="Практический опыт TAINA">
  <Container>
    <div class="case">
      <p class="eyebrow">Опыт в смежном AI-проекте · медицинская компания</p>
      <h2>Практический опыт работы с корпоративными знаниями</h2>
      <p class="lede">Это отдельный проект TAINA по созданию AI-ассистента. Он подтверждает опыт работы с корпоративной базой знаний, но не является кейсом использования TAINA Knowledge Map.</p>
      <h3>Что было сделано</h3>
      <ul>
        {project.case.cells.map((cell) => (
          <li>
            <strong>{cell.label}</strong>
            <span>{cell.text}</span>
          </li>
        ))}
      </ul>
      <p class="note">{project.case.foot}</p>
    </div>
  </Container>
</Section>

<style>
  .case { max-width: 820px; margin-inline: auto; }
  .eyebrow { color: var(--color-gold); font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-3); }
  h2 { font-size: var(--text-2xl); max-width: 24ch; }
  .lede { margin-top: var(--space-4); color: var(--color-sand); font-size: var(--text-lg); max-width: var(--measure); }
  h3 { margin-top: var(--space-6); font-size: var(--text-xl); }
  ul { list-style: none; padding: 0; margin-top: var(--space-4); border-top: 1px solid var(--color-line); }
  li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--color-line); }
  li strong { color: var(--color-gold); font-size: var(--text-sm); }
  li span { color: var(--color-sand); }
  .note { margin-top: var(--space-4); color: var(--color-sand); font-size: var(--text-sm); }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
