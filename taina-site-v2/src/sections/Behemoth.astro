---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import { behemoth } from '@/content/copy';
---

<Section id="behemoth" label={behemoth.title}>
  <Container>
    <h2>{behemoth.title}</h2>
    <div class="text">
      {behemoth.paragraphs.map((paragraph) => <p class="measure">{paragraph}</p>)}
      <p class="quote">«{behemoth.quote}»</p>
    </div>
  </Container>
</Section>

<style>
  h2 {
    font-size: var(--text-2xl);
  }

  .text {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-sand);
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ivory);
  }
</style>
