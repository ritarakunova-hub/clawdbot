---
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { packages, support } from '@/content/prices';
---

<Section id="packages" label="Другие услуги TAINA">
  <Container>
    <div class="intro">
      <p class="eyebrow">Отдельное направление</p>
      <h2>Другие услуги TAINA</h2>
      <p class="lede">Knowledge Map — самостоятельный цифровой продукт. Если вашей компании нужно не упорядочить знания самостоятельно, а разработать и внедрить AI-решение под конкретный процесс, это отдельная услуга с другим объёмом и бюджетом.</p>
    </div>

    <ul class="grid">
      {packages.map((pkg) => (
        <li class="card" data-package={pkg.title}>
          <h3>{pkg.title}</h3>
          <p class="for-whom">{pkg.forWhom}</p>
          <p class="price">{pkg.price}</p>
          <p class="description">{pkg.description}</p>
          <Button href="#contact" variant="outline" size="sm">{pkg.cta}</Button>
        </li>
      ))}
    </ul>

    <div class="support">
      <div>
        <h3>{support.title}</h3>
        <p class="price">{support.price}</p>
        <p class="description">{support.description}</p>
      </div>
      <Button href="#contact" variant="text" size="sm">{support.cta}</Button>
    </div>
  </Container>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-package]').forEach((el) => {
    el.addEventListener('click', () => {
      const title = el.dataset.package;
      if (!title) return;
      try { sessionStorage.setItem('taina:package', title); } catch { /* storage may be unavailable */ }
    });
  });
</script>

<style>
  .intro { max-width: 780px; margin-inline: auto; }
  .eyebrow { color: var(--color-gold); font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-3); }
  h2 { font-size: var(--text-2xl); }
  .lede { margin-top: var(--space-4); color: var(--color-sand); font-size: var(--text-lg); }
  .grid { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
  .card h3, .support h3 { font-size: var(--text-xl); }
  .for-whom, .description { color: var(--color-sand); }
  .for-whom { font-size: var(--text-sm); font-style: italic; }
  .price { color: var(--color-gold); font-size: var(--text-lg); font-weight: 600; }
  .card .btn { margin-top: auto; }
  .support { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-line); display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); }
  .support .description { margin-top: var(--space-2); max-width: 65ch; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .support { align-items: flex-start; flex-direction: column; } }
</style>
