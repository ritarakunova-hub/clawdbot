# Telegram is used only for private drafts and owner approval.
# SMMplanner owns the actual publishing schedule for Telegram and VK.
# Never commit real tokens, IDs or passwords.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_SECRET=

TIMEZONE=Europe/Moscow
CRON_SCHEDULE=0 9 * * *

PORT=3000

