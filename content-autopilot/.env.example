# Set locally in .env or in the hosting provider's secret manager.
# Never commit real tokens, IDs or passwords.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

VK_GROUP_ID=
VK_COMMUNITY_TOKEN=

# Separate secret for the protected /check/now endpoint.
INTERNAL_API_SECRET=

TIMEZONE=Europe/Moscow
CRON_SCHEDULE=0 9 * * *
APPROVAL_WINDOW_MINUTES=30

# false by default. Posts are sent only after the owner taps the Telegram button.
# Set true only after a separate deliberate decision.
AUTO_PUBLISH_ENABLED=false

PORT=3000

# Optional state-file path. In production, point this at a persistent mounted directory.
# PENDING_FILE=/path/to/persistent-volume/taina-pending.json
