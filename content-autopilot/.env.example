# Локально: скопируйте в .env и заполните. На Amvera те же имена
# задаются в личном кабинете → «Переменные и секреты» (как секреты).

# --- Telegram: личный чат (тот же, что в мини-CRM) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram: канал, куда публикуются посты ---
TELEGRAM_CHANNEL_ID=
# Секрет для проверки, что вебхук реально прислал Telegram, а не кто-то ещё
TELEGRAM_WEBHOOK_SECRET=

# --- VK: паблик TAINA STUDIO ---
VK_GROUP_ID=
VK_COMMUNITY_TOKEN=

# --- Расписание ---
TIMEZONE=Europe/Moscow
# Во сколько проверять календарь и слать черновик (по умолчанию — 9:00)
CRON_SCHEDULE=0 9 * * *
# Сколько минут ждать перед автопубликацией, если не нажали кнопку
APPROVAL_WINDOW_MINUTES=30

# --- Прочее ---
PORT=3000
