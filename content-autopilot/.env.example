# Локально: скопируйте в .env и заполните. Не коммитьте реальные значения.

# Telegram: личный чат для уведомлений и черновиков
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram: канал для публикации согласованных постов
TELEGRAM_CHANNEL_ID=

# Обязательный случайный секрет Telegram webhook (создать: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://YOUR-SUBDOMAIN/telegram/webhook

# Отдельный длинный секрет для ручного POST /check/now
# Сгенерируйте на сервере: openssl rand -hex 32
ADMIN_WEBHOOK_SECRET=

# Обязательный числовой Telegram user ID единственного согласующего.
# Задайте ID пользователя явно; TELEGRAM_CHAT_ID не используется как fallback.
TELEGRAM_APPROVER_ID=

# VK: сообщество TAINA STUDIO
VK_GROUP_ID=
VK_COMMUNITY_TOKEN=

# Расписание проверки календаря
TIMEZONE=Europe/Moscow
CRON_SCHEDULE=0 9 * * *

# Порт HTTP-сервиса (в Docker доступен только локальному reverse proxy)
PORT=3000
CONTENT_AUTOPILOT_DATA_DIR=/app/data

# Необязательно: постоянный каталог данных на хостинге
# CONTENT_AUTOPILOT_DATA_DIR=/data/content-autopilot
