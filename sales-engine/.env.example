# Локально: скопируйте в .env и заполните. На Amvera те же имена
# задаются в личном кабинете → «Переменные и секреты» (как секреты).

# --- Claude (анализ, scoring, сообщения) ---
ANTHROPIC_API_KEY=

# --- Outscraper (поиск компаний через Google Maps) ---
OUTSCRAPER_API_KEY=

# --- Google Sheets (база лидов) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- Telegram (карточки лидов + управление) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для проверки, что вебхук реально прислал Telegram, а не кто-то ещё
TELEGRAM_WEBHOOK_SECRET=

# --- Защита веб-формы паролем (Basic Auth) ---
APP_USERNAME=
APP_PASSWORD=

# --- Прочее ---
PORT=3000
# Минимальный score, начиная с которого лид считается "хорошим"
# и получает карточку в Telegram + персональное сообщение
SCORE_THRESHOLD=70
