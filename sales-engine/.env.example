# Локально: скопируйте в .env и заполните. На Amvera те же имена
# задаются в личном кабинете → «Переменные и секреты» (как секреты).

# --- Claude (анализ, scoring, сообщения) ---
ANTHROPIC_API_KEY=

# --- Google Places API (поиск компаний через Google Maps) ---
# Тот же Google-аккаунт/проект, что и для Google Sheets — отдельный API-ключ
GOOGLE_PLACES_API_KEY=

# --- Google Sheets (база лидов) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- Telegram (карточки лидов + управление) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для проверки, что вебхук реально прислал Telegram, а не кто-то ещё
TELEGRAM_WEBHOOK_SECRET=

# --- Защита веб-формы паролем (Basic Auth) ---
APP_USERNAME=
APP_PASSWORD=

# --- Прочее ---
PORT=3000
# Минимальный score, начиная с которого лид считается "хорошим"
# и получает карточку в Telegram + персональное сообщение
SCORE_THRESHOLD=70

# --- Воронка / follow-up (сервис сам проверяет по расписанию) ---
# Через сколько дней без ответа готовить follow-up
FOLLOWUP_DAYS=3
# Сколько follow-up попыток делать, прежде чем закрыть лида как "нет ответа"
MAX_FOLLOWUPS=2
# Расписание проверки в формате cron (по умолчанию — каждый день в 10:00)
CRON_SCHEDULE=0 10 * * *
